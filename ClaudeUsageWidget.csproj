<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="confetti.mp3" CopyToOutputDirectory="PreserveNewest" />
    <None Include="art\*;sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- What the one-file setup unpacks: the art and our own sounds. Never Blizzard's audio, which a shared copy fetches itself. -->
    <EmbeddedResource Include="art\*;sounds\explode.wav;confetti.mp3" LogicalName="payload/%(RelativeDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Windows won't overwrite a running exe but will rename it, so publishing works while the widget runs.
       The widget then sees the new exe and restarts into it. The previous .old goes on the next publish. -->
  <Target Name="MoveRunningExeAside" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <RunningExe>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))$(AssemblyName).exe</RunningExe> <!-- `-o dist` gives no trailing slash -->
    </PropertyGroup>
    <Delete Files="$(RunningExe).old" ContinueOnError="true" />
    <Move SourceFiles="$(RunningExe)" DestinationFiles="$(RunningExe).old" Condition="Exists('$(RunningExe)')" ContinueOnError="true" />
  </Target>
</Project>
